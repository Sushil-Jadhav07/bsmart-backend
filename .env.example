PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/b_smart
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY_HERE
# Sign in with Apple — web flow (passport-apple) needs all 5 to activate.
# The native /api/auth/apple/token flow only needs APPLE_CLIENT_ID (as an
# accepted audience) and works without the rest.
APPLE_CLIENT_ID=your_apple_services_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
APPLE_CALLBACK_URL=http://localhost:5000/api/auth/apple/callback
# Optional — bundle id of your native iOS app, accepted as an additional
# token audience for the native /api/auth/apple/token flow
APPLE_BUNDLE_ID=com.yourcompany.yourapp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM_NAME=B-Smart
# Voice/video calling — Cloudflare Realtime (media relay). Without these,
# call signaling (ringing, accept/reject, call log) still works, but no
# media session id is created, so the client can't actually connect audio/video.
CLOUDFLARE_REALTIME_APP_ID=your_cloudflare_realtime_app_id
CLOUDFLARE_REALTIME_APP_TOKEN=your_cloudflare_realtime_app_token
# Voice/video calling — Apple PushKit VoIP push (iOS call ringing when the
# app is backgrounded/killed). Also requires `npm install apn`. Without
# these, iOS calls only ring while the bsmart app is already open.
APNS_KEY_PATH=/absolute/path/to/AuthKey_VOIP.p8
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apple_team_id
APNS_VOIP_BUNDLE_ID=com.ruvees.bsmart.ios
