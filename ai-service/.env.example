# Same database the Node API uses.
MONGO_URI=mongodb://127.0.0.1:27017/b_smart
# Shared secret. Put the same value in the Node API's .env as AI_SERVICE_TOKEN.
AI_SERVICE_TOKEN=change-me-to-a-long-random-string
# How media URLs are built (same values as the Node API).
PUBLIC_BASE_URL=https://api.bebsmart.in
CLOUDFRONT_BASE_URL=

# Optional
# AI_INDEX_DAYS=90            content kept in the search index
# AI_SYNC_INTERVAL_S=15       how often new content is picked up
# AI_RECONCILE_HOUR_UTC=21    nightly clean-up (21 UTC = 02:30 IST)
# AI_TAG_MIN_PROB=0.2         raise to tag fewer, surer labels
# AI_DEVICE=cpu
# FFMPEG_PATH=ffmpeg
