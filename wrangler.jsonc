{
  "name": "bsmart-backend-dev",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-22",
  "observability": { "enabled": true },

  "containers": [
    {
      "class_name": "BsmartDev",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      { "class_name": "BsmartDev", "name": "BSMART_DEV" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BsmartDev"] }
    
  ]
  
}
